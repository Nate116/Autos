{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@washlink/shared/*": ["packages/shared/src/*"],
      "@washlink/db": ["packages/db/src"],
      "@washlink/api/*": ["packages/api/src/*"]
    }
  }
}
