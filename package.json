{
  "name": "washlink",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "db:push": "pnpm -C packages/db prisma db push",
    "db:studio": "pnpm -C packages/db prisma studio",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "start:api": "pnpm -C packages/api start:dev",
    "dev:all": "pnpm -w dlx concurrently \"pnpm -C packages/api dev\" \"pnpm -C apps/web dev\" \"pnpm -C apps/mobile start --web --non-interactive\""
  },
  "devDependencies": {
    "concurrently": "^9",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0"
  }
}
